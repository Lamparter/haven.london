---
import { perks } from "../data/event";
---

<section id="about" class="about">
  <div class="shell">
    <h2 class="title">What is Haven London?</h2>
    <p class="intro">
      Haven London is a free <span class="marker">high school hackathon in London</span> for teens
      aged 13-18. It's a game jam: a social coding event where you make a video game with friends (plus
      free food!). It doesn't matter if you have years of experience or just learned what a game jam
      is today.
    </p>
    <p class="more">
      Haven is run by <a href="https://hackclub.com">Hack Club</a>, the nonprofit network of teen
      coders, and happens in cities all over the world (see
      <a href="https://haven.hackclub.com">Haven worldwide</a>). We've hosted events in London
      before, including Daydream, Campfire and Sunbeam. Haven London is the next one.
    </p>

    <ul class="perks">
      {
        perks.map((perk) => (
          <li class="panel">
            <span class="icon" aria-hidden="true">
              {perk.icon}
            </span>
            <h3>{perk.title}</h3>
            <p>{perk.blurb}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    position: relative;
    /* Extra room up top for the hero's foliage, which hangs over this section. */
    padding: clamp(7rem, 14vw, 11rem) 0 calc(var(--section-pad) + var(--wave-h));
    background: linear-gradient(var(--haven-green), var(--haven-green-deep));
    text-align: center;
  }

  .intro {
    max-width: 40rem;
    margin: 1.5rem auto 3.5rem;
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 0.06em 0 rgb(111 118 18 / 0.8);
  }

  .more {
    max-width: 40rem;
    margin: -2rem auto 3.5rem;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.45;
    color: #fff;
    text-shadow: 0 0.06em 0 rgb(111 118 18 / 0.8);
  }

  .more a {
    color: var(--haven-butter);
  }

  .intro .marker {
    color: var(--haven-orange-deep);
    text-shadow: none;
  }

  .perks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel {
    position: relative;
    padding: 2.6rem 1.5rem 1.6rem;
    background: var(--haven-cream);
    border-radius: 1.4rem;
    box-shadow: 0 0.4rem 0 var(--haven-green-dark);
    transition: transform 0.25s var(--ease-bounce);
  }

  .panel:nth-child(1) {
    rotate: -1.5deg;
  }

  .panel:nth-child(3) {
    rotate: 1.5deg;
  }

  .panel:hover {
    transform: translateY(-6px) scale(1.02);
  }

  .icon {
    position: absolute;
    top: -1.6rem;
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 3.4rem;
    aspect-ratio: 1;
    background: var(--haven-yellow);
    border: 0.25rem solid var(--haven-cream);
    border-radius: 50%;
    font-size: 1.6rem;
  }

  h3 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    color: var(--haven-orange-deep);
  }

  .panel p {
    margin: 0.75rem 0 0;
    font-size: 1.1rem;
    line-height: 1.4;
  }
</style>
