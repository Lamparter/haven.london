---
import Roundel from "./Roundel.astro";
import { sponsors, team } from "../data/event";

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join("");
---

<section id="team" class="people wavy">
  <div class="shell">
    <Roundel label="The crew" />
    <h2 class="title on-light">Meet the organisers</h2>
    <p class="sub">The people making Haven London happen. Come say hi on the day!</p>
    <ul class="team">
      {
        team.map((person) => (
          <li>
            {person.photo ? (
              <img src={person.photo} alt="" loading="lazy" />
            ) : (
              <span class="avatar" aria-hidden="true">
                {initials(person.name)}
              </span>
            )}
            <span class="name">{person.name}</span>
            {person.role && <span class="role">{person.role}</span>}
          </li>
        ))
      }
    </ul>

    <div id="sponsors" class="sponsors-wrap">
      <h2 class="small-title">Supported by</h2>
      <ul class="sponsors">
        {
          sponsors.map((s) => (
            <li>
              {s.logo && s.logoHasName ? (
                <a href={s.href} class="logo-only">
                  <img src={s.logo} alt={s.name} />
                </a>
              ) : (
                <a href={s.href}>
                  {s.logo && <img src={s.logo} alt="" />}
                  <span>{s.name}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .people {
    padding-bottom: calc(var(--section-pad) + var(--wave-h));
    background: var(--haven-cream);
    text-align: center;
  }

  h2 {
    margin-top: 1rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 2rem 1.5rem;
    margin-top: 3rem;
  }

  .team li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .team img,
  .avatar {
    width: 7.5rem;
    aspect-ratio: 1;
    margin-bottom: 0.4rem;
    border: 0.35rem solid #fff;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 0.3rem var(--haven-yellow),
      0 0.6rem 0 0.3rem var(--haven-gold);
    rotate: -4deg;
    transition: rotate 0.3s var(--ease-bounce);
  }

  .team li:nth-child(even) :is(img, .avatar) {
    rotate: 4deg;
  }

  .team li:hover :is(img, .avatar) {
    rotate: 0deg;
  }

  .avatar {
    display: grid;
    place-items: center;
    background: var(--haven-butter);
    color: var(--haven-orange-deep);
    font-family: var(--font-display);
    font-size: 2.6rem;
  }

  .name {
    margin-top: 0.4rem;
    font-size: 1.25rem;
    color: var(--haven-bark);
  }

  .role {
    padding: 0.05rem 0.6rem;
    background: var(--haven-orange-deep);
    border-radius: 999px;
    color: #fff;
    font-size: 0.85rem;
  }

  .sponsors-wrap {
    margin-top: clamp(4rem, 8vw, 5.5rem);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--haven-butter);
    border-radius: 1.6rem;
  }

  .small-title {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--haven-orange-deep);
  }

  .sponsors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .sponsors a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1.4rem 0.75rem 0.75rem;
    background: #fff;
    border-radius: 1.1rem;
    box-shadow: 0 0.3rem 0 var(--haven-gold);
    color: var(--haven-bark);
    font-size: 1.25rem;
    text-decoration: none;
    transition: transform 0.2s var(--ease-bounce);
  }

  .sponsors a:hover {
    transform: translateY(-3px) rotate(-1deg);
  }

  .sponsors img {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    border-radius: 0.6rem;
  }

  /* Wordmark logos carry the name themselves, so they get the whole card. */
  .sponsors .logo-only {
    justify-content: center;
    min-width: 10rem;
    height: 5.5rem;
    padding: 0.75rem 1.25rem;
  }

  .sponsors .logo-only img {
    width: auto;
    max-width: 9rem;
    height: 100%;
    border-radius: 0.4rem;
  }
</style>
