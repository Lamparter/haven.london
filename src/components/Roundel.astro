---
/** A Tube-station-style sign used as a section kicker: a small roundel followed by the label. */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="sign">
  <svg class="roundel" viewBox="0 0 40 32" aria-hidden="true" focusable="false">
    <circle cx="20" cy="16" r="12" fill="none" stroke="var(--haven-orange-deep)" stroke-width="6" />
    <rect x="1" y="12" width="38" height="8" fill="var(--haven-teal)" />
  </svg>
  {label}
</span>

<style>
  .sign {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem 0.35rem 0.5rem;
    background: #fff;
    border-radius: 999px;
    box-shadow: 0 0.2rem 0 rgb(0 0 0 / 0.12);
    color: var(--haven-bark);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: -2deg;
  }

  .roundel {
    width: 2.1rem;
    height: auto;
  }
</style>
