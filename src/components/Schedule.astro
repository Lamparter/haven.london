---
import Roundel from "./Roundel.astro";
import { event, schedule, scheduleNote } from "../data/event";
---

<section id="schedule" class="schedule wavy">
  <div class="shell">
    <Roundel label="Schedule" />
    <h2 class="title on-light">On the day</h2>
    <p class="sub">{event.dateLabel} · {event.timeLabel} · subject to change!</p>

    <!-- Drawn as a station departure board: one row per stop on the day. -->
    <div class="board">
      <div class="board-head">
        <span>Haven Line</span>
        <span class="platform">Platform 1</span>
      </div>
      <ol class="rows">
        {
          schedule.length ? (
            schedule.map((stop) => (
              <li>
                <span class="time">{stop.time}</span>
                <span class="dest">
                  {stop.title}
                  {stop.detail && <small>{stop.detail}</small>}
                </span>
                <span class="status">On time</span>
              </li>
            ))
          ) : (
            <li>
              <span class="time">09:00</span>
              <span class="dest">Haven London</span>
              <span class="status blink">Timetable TBC</span>
            </li>
          )
        }
      </ol>
      {
        !schedule.length && (
          <p class="ticker">
            <span>{scheduleNote}</span>
          </p>
        )
      }
    </div>
    {
      !schedule.length && (
        <p class="cta">
          <a class="button" href="#signup">
            get notified
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .schedule {
    padding-bottom: calc(var(--section-pad) + var(--wave-h));
    background: var(--haven-butter);
    text-align: center;
  }

  h2 {
    margin-top: 1rem;
  }

  .board {
    max-width: 46rem;
    margin: 2.5rem auto 0;
    padding: 0.75rem;
    background: #2a1a10;
    border: 0.5rem solid var(--haven-bark);
    border-radius: 1.25rem;
    box-shadow:
      0 0.5rem 0 var(--haven-brown-dark),
      inset 0 0 2rem rgb(0 0 0 / 0.6);
    text-align: left;
    color: var(--haven-yellow);
    font-family: var(--font-board);
    font-weight: 700;
    text-transform: uppercase;
  }

  .board-head {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.6rem 0.6rem;
    border-bottom: 2px dashed rgb(255 208 89 / 0.25);
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    color: var(--haven-orange-mid);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    display: grid;
    grid-template-columns: 5ch 1fr auto;
    gap: 0 1.25rem;
    align-items: baseline;
    padding: 0.7rem 0.6rem;
    font-size: clamp(1.1rem, 2.6vw, 1.6rem);
  }

  .rows li + li {
    border-top: 1px solid rgb(255 208 89 / 0.12);
  }

  .dest small {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.6em;
    opacity: 0.75;
  }

  .status {
    font-size: 0.75em;
    color: var(--haven-teal);
  }

  .blink {
    animation: blink 1.2s steps(2, jump-none) infinite;
  }

  .ticker {
    overflow: hidden;
    margin: 0;
    padding: 0.6rem;
    border-top: 2px dashed rgb(255 208 89 / 0.25);
    font-size: clamp(0.85rem, 1.8vw, 1.05rem);
    white-space: nowrap;
    color: var(--haven-orange-mid);
  }

  .ticker span {
    display: inline-block;
    padding-left: 100%;
    animation: ticker 22s linear infinite;
  }

  .cta {
    margin: 2.5rem 0 0;
  }

  @keyframes blink {
    to {
      opacity: 0.25;
    }
  }

  @keyframes ticker {
    to {
      translate: -100% 0;
    }
  }

  /* With motion off, the note just wraps in place instead of scrolling past. */
  @media (prefers-reduced-motion: reduce) {
    .ticker {
      white-space: normal;
    }

    .ticker span {
      padding-left: 0;
      animation: none;
    }
  }

  @media (width < 32rem) {
    .rows li {
      grid-template-columns: 5ch 1fr;
    }

    .status {
      grid-column: 2;
    }
  }
</style>
