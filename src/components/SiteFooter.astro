---
import Skyline from "./Skyline.astro";
import SignupForm from "./SignupForm.astro";
import { event } from "../data/event";

const links = [
  { href: "https://hackclub.com", label: "Hack Club" },
  { href: "https://haven.hackclub.com", label: "Haven worldwide" },
  { href: "https://hackclub.com/slack", label: "Slack" },
  { href: "https://hackclub.com/conduct", label: "Code of Conduct" },
];
---

<div class="skyline-wrap"><Skyline /></div>
<footer class="footer">
  <div class="shell">
    <div class="cta">
      <h2>Don't miss out!</h2>
      <p>{event.dateLabel} · {event.venueShort}</p>
      <SignupForm id="footer-signup-email" />
    </div>

    <div class="inner">
      <div>
        <img src="/images/logo.webp" alt="Hack Club Haven" width="762" height="491" class="logo" />
      </div>
      <nav aria-label="Hack Club">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="body">
        <p>
          Haven London is part of Hack Club Haven, a global game jam for teens in 200+ cities. Hack
          Club is a 501(c)(3) nonprofit and network of 100k+ technical high schoolers.
        </p>
        <p>
          Questions? <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a>
        </p>
        <p>Made with 💛 by <a href="https://instagram.com/jupitercussens">Lamparter</a>.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .skyline-wrap {
    background: var(--haven-green-deep);
  }

  .footer {
    padding: clamp(1rem, 3vw, 2rem) 0 clamp(2.5rem, 5vw, 4rem);
    background: var(--haven-orange-deep);
    color: #fff;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 2px dashed rgb(255 255 255 / 0.35);
    text-align: center;
  }

  h2 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    text-shadow: 0 0.06em 0 #b83f0b;
    rotate: -2deg;
  }

  .cta p {
    margin: 0.9rem 0 1.5rem;
    font-size: 1.15rem;
    color: var(--haven-butter);
  }

  .inner {
    display: grid;
    gap: 2rem;
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (width >= 48rem) {
    .inner {
      grid-template-columns: auto auto 1fr;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .logo {
    width: clamp(7rem, 16vw, 9.5rem);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    ul {
      flex-direction: column;
    }
  }

  ul a {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: -0.05em;
    text-decoration: none;
    transition: color 0.15s;
  }

  ul a:hover {
    color: var(--haven-yellow);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 32rem;
    line-height: 1.45;
  }

  .body p {
    margin: 0;
  }

  .body a {
    color: var(--haven-butter);
  }
</style>
