---
import Countdown from "./Countdown.astro";
import { navLinks } from "../data/event";
---

<header class="site-header" data-header>
  <Countdown />
  <nav class="nav" aria-label="Primary">
    <a href="#top" class="brand" aria-label="Haven London — home">
      <img src="/images/logo.webp" alt="Hack Club Haven" width="778" height="445" />
      <span>London</span>
    </a>
    <ul>
      {
        navLinks.map((link) => (
          <li class:list={{ wide: link.wide }}>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
      <li><a href="#signup" class="cta">sign up</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem clamp(1rem, 4vw, 3rem);
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }

  .site-header[data-scrolled] .nav {
    background: rgb(184 194 32 / 0.85);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.08);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    text-shadow: 0 0 8px var(--haven-orange-deep);
  }

  .brand img {
    width: clamp(3.5rem, 7vw, 5rem);
    filter: drop-shadow(0 0 6px rgb(237 86 21 / 0.6));
  }

  ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.9rem);
    letter-spacing: -0.03em;
    color: var(--haven-yellow);
    text-decoration: none;
    text-shadow: 0 0 8px rgb(237 86 21 / 0.7);
    transition: color 0.15s;
  }

  ul {
    align-items: center;
  }

  ul a:hover {
    color: #fff;
  }

  ul a.cta {
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: var(--haven-orange-deep);
    color: #fff;
    text-shadow: none;
    transition: transform 0.2s var(--ease-bounce);
  }

  ul a.cta:hover {
    transform: scale(1.06);
  }

  /* Phones get the essentials only. */
  @media (width < 40rem) {
    .wide,
    .brand span {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", window.scrollY > 10);
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
