---
/** A London skyline silhouette: Elizabeth Tower, the Eye, St Paul's, the Gherkin and the Shard. */
---

<svg
  class="skyline"
  viewBox="0 0 1440 220"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <g fill="currentColor">
    <!-- low rooftops along the whole width -->
    <path
      d="M0 220V170h60v-20h50v30h40v-40h70v50h50v-25h40v25h420v-30h60v15h50v-35h60v40h70v-20h60v30h40v-45h80v35h60v-25h50v40h80v50z"
    />

    <!-- Elizabeth Tower -->
    <rect x="150" y="70" width="34" height="150" />
    <rect x="144" y="60" width="46" height="18" />
    <polygon points="146,60 167,8 188,60" />
    <rect x="165" y="0" width="4" height="12" />

    <!-- Palace of Westminster -->
    <rect x="184" y="140" width="140" height="80" />
    <polygon points="190,140 197,120 204,140" />
    <polygon points="240,140 247,120 254,140" />
    <polygon points="290,140 297,120 304,140" />

    <!-- St Paul's -->
    <rect x="560" y="150" width="120" height="70" />
    <rect x="590" y="120" width="60" height="30" />
    <path d="M585 125a35 35 0 0 1 70 0z" />
    <rect x="617" y="70" width="6" height="22" />

    <!-- Gherkin -->
    <path d="M880 220 C 865 150 870 90 900 60 C 930 90 935 150 920 220z" />

    <!-- the Shard -->
    <polygon points="1020,220 1068,10 1078,10 1120,220" />

    <!-- tall office blocks -->
    <rect x="960" y="110" width="40" height="110" />
    <rect x="1130" y="90" width="44" height="130" />
    <rect x="1190" y="130" width="30" height="90" />
  </g>

  <!-- the London Eye, outlined so it reads as a wheel -->
  <g fill="none" stroke="currentColor" stroke-width="5">
    <circle cx="420" cy="110" r="70" />
    <path d="M420 40v140M350 110h140M370.5 60.5l99 99M469.5 60.5l-99 99" stroke-width="2" />
  </g>
  <polygon fill="currentColor" points="420,110 390,220 450,220" />
</svg>

<style>
  .skyline {
    display: block;
    width: 100%;
    height: clamp(6rem, 14vw, 13rem);
    color: var(--haven-orange-deep);
    margin-bottom: -1px;
  }
</style>
