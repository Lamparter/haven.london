---
import Roundel from "./Roundel.astro";
import { venue } from "../data/event";

/** Official TfL line colours, so the station chips read as the real thing. */
const lineColours: Record<string, { bg: string; fg: string }> = {
  Bakerloo: { bg: "#b36305", fg: "#fff" },
  Central: { bg: "#e32017", fg: "#fff" },
  Circle: { bg: "#ffd300", fg: "#000f9f" },
  District: { bg: "#00782a", fg: "#fff" },
  "Elizabeth line": { bg: "#6950a1", fg: "#fff" },
  "Hammersmith & City": { bg: "#f3a9bb", fg: "#000f9f" },
  Jubilee: { bg: "#a0a5a9", fg: "#000f9f" },
  Metropolitan: { bg: "#9b0056", fg: "#fff" },
  Northern: { bg: "#000", fg: "#fff" },
  Piccadilly: { bg: "#003688", fg: "#fff" },
  Victoria: { bg: "#0098d4", fg: "#fff" },
  "Waterloo & City": { bg: "#95cdba", fg: "#000f9f" },
};
---

<section id="venue" class="venue wavy">
  <div class="shell">
    <Roundel label="Getting there" />
    <h2 class="title">{venue.name}</h2>
    <p class="sub address">{venue.address ?? "Full address coming soon"}</p>

    <div class="grid">
      <div class="map">
        {
          venue.mapEmbedUrl ? (
            <iframe
              src={venue.mapEmbedUrl}
              title={`Map of ${venue.name}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          ) : (
            <p class="placeholder">Map coming soon 🗺️</p>
          )
        }
      </div>

      <div class="panel">
        <h3>By Tube</h3>
        {
          venue.travel.length ? (
            <ul class="stations">
              {venue.travel.map((t) => (
                <li>
                  <svg class="mini-roundel" viewBox="0 0 40 32" aria-hidden="true" focusable="false">
                    <circle cx="20" cy="16" r="12" fill="none" stroke="#dc241f" stroke-width="6" />
                    <rect x="1" y="12" width="38" height="8" fill="#000f9f" />
                  </svg>
                  <span class="station">{t.station}</span>
                  <span class="lines">
                    {t.lines.map((line) => {
                      const colour = lineColours[line] ?? { bg: "var(--haven-teal)", fg: "#fff" };
                      return (
                        <span class="line-name" style={`--line-bg: ${colour.bg}; --line-fg: ${colour.fg}`}>
                          {line}
                        </span>
                      );
                    })}
                  </span>
                  {t.note && <span class="note">{t.note}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p>Nearest stations will go here once the campus is confirmed.</p>
          )
        }

        <h3>Good to know</h3>
        <ul class="notes">
          {venue.notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .venue {
    padding-bottom: calc(var(--section-pad) + var(--wave-h));
    background: var(--haven-green);
    text-align: center;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
  }

  .address {
    color: #fff;
    text-shadow: 0 0.06em 0 rgb(111 118 18 / 0.8);
  }

  .grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: 2.5rem;
    text-align: left;
  }

  @media (width >= 48rem) {
    .grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .map,
  .panel {
    border-radius: 1.4rem;
    box-shadow: 0 0.4rem 0 var(--haven-green-dark);
  }

  .map {
    display: grid;
    place-items: center;
    min-height: 20rem;
    overflow: hidden;
    background: var(--haven-cream);
    border: 0.4rem solid var(--haven-cream);
  }

  .map iframe {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    border: 0;
    border-radius: 1rem;
  }

  .placeholder {
    font-size: 1.3rem;
  }

  .panel {
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--haven-cream);
  }

  h3 {
    font-size: 1.8rem;
    color: var(--haven-orange-deep);
  }

  h3:not(:first-child) {
    margin-top: 1.75rem;
  }

  .stations,
  .notes {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stations li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    align-items: center;
    padding: 0.35rem 0;
  }

  .mini-roundel {
    width: 1.9rem;
    height: auto;
  }

  .station {
    font-size: 1.25rem;
    color: var(--haven-bark);
  }

  .lines {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .line-name {
    padding: 0.1rem 0.55rem;
    background: var(--line-bg);
    border-radius: 0.4rem;
    color: var(--line-fg);
    font-size: 0.85rem;
  }

  .note {
    width: 100%;
    padding-left: 2.5rem;
    font-size: 0.95rem;
  }

  .notes li {
    position: relative;
    padding: 0.4rem 0 0.4rem 1.6rem;
    line-height: 1.4;
  }

  .notes li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.75rem;
    width: 0.7rem;
    aspect-ratio: 1;
    background: var(--haven-orange-mid);
    border-radius: 50%;
    box-shadow: 0 0 0 0.2rem var(--haven-butter);
  }
</style>
